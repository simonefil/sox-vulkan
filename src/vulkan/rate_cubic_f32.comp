/* FP32 cubic interpolation for the SoX quick rate stage. */

/* The fast profile's member of the cubic family; rate_cubic_f64.comp carries
 * the family's rationale.  Plain FP32 with no `precise` and an fma-folded
 * Horner evaluation: this profile is the one that wants the compiler to
 * contract, and the cancellation in the coefficients is accepted.
 *
 * Bindings, in the order rate_cubic_vulkan.c writes them:
 *   0 input_samples   -- in: interleaved input frames.
 *   1 output_samples  -- out: interleaved output frames.
 *
 * Push constants (parameters_t, 32 bytes): output_frames, step_integer,
 * step_fraction, phase_fraction, channels, padding0..2.  The step and phase
 * are 32.32 and 0.32 fixed point, so the position stays exact however long
 * the stream runs even though the samples do not.
 *
 * Dispatch is two-dimensional, x over output_frames in workgroups of 128 and
 * y one invocation per channel, hence both bounds tests.  The +1 on
 * input_frame is the history the cubic window needs, reserved by the host as
 * pre_post along with the two frames after it.
 */

#version 450

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer InputSamples {
  float input_samples[];
};

layout(std430, binding = 1) writeonly buffer OutputSamples {
  float output_samples[];
};

layout(push_constant) uniform Parameters {
  uint output_frames;
  uint step_integer;
  uint step_fraction;
  uint phase_fraction;
  uint channels;
  uint padding0;
  uint padding1;
  uint padding2;
} parameters;

void main()
{
  uint output_frame = gl_GlobalInvocationID.x;
  uint channel = gl_GlobalInvocationID.y;
  uint product_high;
  uint product_low;
  uint fraction;
  uint carry;
  uint input_frame;

  if (output_frame >= parameters.output_frames || channel >= parameters.channels)
    return;

  umulExtended(output_frame, parameters.step_fraction, product_high, product_low);
  fraction = parameters.phase_fraction + product_low;
  carry = fraction < product_low ? 1u : 0u;
  input_frame = 1u + output_frame * parameters.step_integer + product_high + carry;
  float x = float(fraction) * (1.0 / 4294967296.0);
  float sample_m1 = input_samples[(input_frame - 1u) * parameters.channels + channel];
  float sample_0 = input_samples[input_frame * parameters.channels + channel];
  float sample_1 = input_samples[(input_frame + 1u) * parameters.channels + channel];
  float sample_2 = input_samples[(input_frame + 2u) * parameters.channels + channel];
  float b = 0.5 * (sample_1 + sample_m1) - sample_0;
  float a = (1.0 / 6.0) * (sample_2 - sample_1 + sample_m1 - sample_0 - 4.0 * b);
  float c = sample_1 - sample_0 - a - b;
  output_samples[output_frame * parameters.channels + channel] = fma(fma(a, x, b), x, c) * x + sample_0;
}
