/* The FP32 member of the prepare family; rate_prepare_f64.comp carries the
 * family's rationale, and this differs from it only in element type.  One
 * float per sample, no compensation anywhere: a profile that chooses this has
 * already accepted FP32 rounding through the whole chain.
 *
 * The fast profile lands here.  The family has no compensated
 * member because it does not accumulate -- see resident_kernel() in
 * rate_vulkan.c.
 *
 * Bindings, in the order record_resident_prepare() in rate_vulkan.c writes
 * them:
 *   0 input_samples     -- in: the producer's resident block, bound at its
 *                          own offset and read through its own strides.
 *   1 prepared_samples  -- out: the FIR's prepared input, planar, two blocks
 *                          per channel.
 *   2 previous_samples  -- in/out: the overlap carried between blocks.
 *
 * Push constants (prepare_parameters_t, 28 bytes): block_frames,
 * input_frames, input_frame_stride, input_channel_stride,
 * prepared_channel_stride, up_factor and channels.
 *
 * Dispatch is two-dimensional, x over block_frames in workgroups of 128 and
 * y one invocation per channel, hence both bounds tests; an invocation owns
 * one (channel, frame), so nothing here synchronises.
 */

#version 450

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer InputSamples {
  float input_samples[];
};

layout(std430, binding = 1) writeonly buffer PreparedSamples {
  float prepared_samples[];
};

layout(std430, binding = 2) buffer PreviousSamples {
  float previous_samples[];
};

layout(push_constant) uniform Parameters {
  uint block_frames;
  uint input_frames;
  uint input_frame_stride;
  uint input_channel_stride;
  uint prepared_channel_stride;
  uint up_factor;
  uint channels;
} parameters;

void main()
{
  uint frame = gl_GlobalInvocationID.x;
  uint channel = gl_GlobalInvocationID.y;
  if (frame >= parameters.block_frames || channel >= parameters.channels)
    return;

  uint previous_index = channel * parameters.block_frames + frame;
  uint prepared_index = channel * parameters.prepared_channel_stride + frame;
  float value = 0.0;
  if (frame % parameters.up_factor == 0u) {
    uint input_frame = frame / parameters.up_factor;
    if (input_frame < parameters.input_frames)
      value = input_samples[
          input_frame * parameters.input_frame_stride +
          channel * parameters.input_channel_stride] *
          float(parameters.up_factor);
  }
  prepared_samples[prepared_index] = previous_samples[previous_index];
  prepared_samples[prepared_index + parameters.block_frames] = value;
  previous_samples[previous_index] = value;
}
