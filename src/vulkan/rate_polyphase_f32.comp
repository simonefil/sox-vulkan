#version 450

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer Coefficients {
  float coefficients[];
};

layout(std430, binding = 1) readonly buffer InputSamples {
  float input_samples[];
};

layout(std430, binding = 2) writeonly buffer OutputSamples {
  float output_samples[];
};

layout(push_constant) uniform Parameters {
  uint output_frames;
  uint phase_count;
  uint phase_step;
  uint phase_start;
  uint taps;
  uint channels;
  uint normalize;
  uint padding;
} parameters;

const float SOX_SAMPLE_SCALE = 1.0 / 2147483647.0;

void main()
{
  uint output_frame = gl_GlobalInvocationID.x;
  uint channel = gl_GlobalInvocationID.y;
  if (output_frame >= parameters.output_frames ||
      channel >= parameters.channels)
    return;

  uint position = parameters.phase_start +
      output_frame * parameters.phase_step;
  uint input_base = position / parameters.phase_count;
  uint phase = position % parameters.phase_count;
  float scale =
      parameters.normalize != 0u ? SOX_SAMPLE_SCALE : 1.0;
  float sum = 0.0;
  for (uint tap = 0u; tap < parameters.taps; ++tap)
    sum = fma(
        coefficients[tap * parameters.phase_count + phase],
        input_samples[
            (input_base + tap) *
            parameters.channels + channel],
        sum);
  output_samples[output_frame * parameters.channels + channel] =
      sum * scale;
}
