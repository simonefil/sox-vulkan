#version 450
#extension GL_ARB_gpu_shader_fp64 : require

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer InputSamples {
  double input_samples[];
};

layout(std430, binding = 1) writeonly buffer PreparedSamples {
  double prepared_samples[];
};

layout(std430, binding = 2) buffer PreviousSamples {
  double previous_samples[];
};

layout(push_constant) uniform Parameters {
  uint block_frames;
  uint input_frames;
  uint input_frame_stride;
  uint input_channel_stride;
  uint prepared_channel_stride;
  uint up_factor;
  uint channels;
  uint padding;
} parameters;

void main()
{
  uint frame = gl_GlobalInvocationID.x;
  uint channel = gl_GlobalInvocationID.y;
  if (frame >= parameters.block_frames || channel >= parameters.channels)
    return;

  uint previous_index = channel * parameters.block_frames + frame;
  uint prepared_index = channel * parameters.prepared_channel_stride + frame;
  double value = 0.0;
  if (frame % parameters.up_factor == 0u) {
    uint input_frame = frame / parameters.up_factor;
    if (input_frame < parameters.input_frames)
      value = input_samples[input_frame * parameters.input_frame_stride + channel * parameters.input_channel_stride] * double(parameters.up_factor);
  }
  prepared_samples[prepared_index] = previous_samples[previous_index];
  prepared_samples[prepared_index + parameters.block_frames] = value;
  previous_samples[previous_index] = value;
}
