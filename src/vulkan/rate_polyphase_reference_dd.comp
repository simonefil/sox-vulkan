/* The reference profile's member of the polyphase family;
 * rate_polyphase_f64.comp carries the family's rationale.  Coefficients,
 * samples and the accumulator are all double-double pairs and every step goes
 * through double_double.glsl, which states the rules that keep the compiler
 * from folding the low words away.  Nothing here rounds until the caller
 * decides to narrow, and the plain-FP32 narrowing variant is a separate
 * shader, rate_polyphase_reference_dd_normalized_f32.comp.
 *
 * Bindings, in the order rate_polyphase_vulkan.c writes them:
 *   0 coefficients    -- in: the response, tap major, phase minor, pairs.
 *   1 input_samples   -- in: interleaved input frames, pairs.
 *   2 output_samples  -- out: interleaved output frames, pairs.
 *
 * Push constants (parameters_t, 32 bytes): output_frames, phase_count,
 * phase_step, phase_start, taps, channels, normalize, symmetric_presum.  The
 * counter's quotient by phase_count is the input frame and its remainder the
 * sub-filter.  The strides count dvec2 elements, not doubles.
 *
 * Dispatch is two-dimensional, x over the output frames in workgroups of 128
 * and y one invocation per channel, hence both bounds tests.
 */

#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

#include "double_double.glsl"

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer Coefficients {
  dvec2 values[];
} coefficients;

layout(std430, binding = 1) readonly buffer InputSamples {
  dvec2 values[];
} input_samples;

layout(std430, binding = 2) writeonly buffer OutputSamples {
  dvec2 values[];
} output_samples;

layout(push_constant) uniform Parameters {
  uint output_frames;
  uint phase_count;
  uint phase_step;
  uint phase_start;
  uint taps;
  uint channels;
  uint normalize;
  uint symmetric_presum;
} parameters;

const double SOX_SAMPLE_SCALE = 1.0 / 2147483647.0;

void main()
{
  const uint output_frame = gl_GlobalInvocationID.x;
  const uint channel = gl_GlobalInvocationID.y;

  if (output_frame >= parameters.output_frames || channel >= parameters.channels)
    return;

  const uint position = parameters.phase_start + output_frame * parameters.phase_step;
  const uint input_base = position / parameters.phase_count;
  const uint phase = position % parameters.phase_count;
  dvec2 sum = dvec2(0.0);

  /* The symmetric form: a linear-phase response has coefficient[tap] equal to
   * coefficient[taps - 1 - tap], so the mirrored input pair can be added
   * before the one multiply, halving them.  The host only sets this for a
   * response that really is symmetric, and it also requires phase_count == 1
   * and an odd tap count, which is why the coefficient index has no phase
   * term.  The zero test skips the exact zeros of a half-band response. */
  if (parameters.symmetric_presum != 0u) {
    const uint center = parameters.taps / 2u;
    const dvec2 center_coefficient = coefficients.values[center];
    const dvec2 center_input = input_samples.values[(input_base + center) * parameters.channels + channel];

    sum = multiply_dd(center_coefficient, center_input);
    for (uint tap = 0u; tap < center; ++tap) {
      const dvec2 coefficient = coefficients.values[tap];

      if (coefficient.x != 0.0 || coefficient.y != 0.0) {
        const dvec2 pair = add_dd(
            input_samples.values[
                (input_base + tap) *
                parameters.channels + channel],
            input_samples.values[
                (input_base + parameters.taps - 1u - tap) *
                parameters.channels + channel]);

        sum = add_dd(sum, multiply_dd(coefficient, pair));
      }
    }
  }
  else {
    for (uint tap = 0u; tap < parameters.taps; ++tap) {
      const dvec2 coefficient = coefficients.values[tap * parameters.phase_count + phase];
      const dvec2 input_value = input_samples.values[(input_base + tap) * parameters.channels + channel];

      sum = add_dd(sum, multiply_dd(coefficient, input_value));
    }
  }
  if (parameters.normalize != 0u)
    sum = multiply_dd_scalar(sum, SOX_SAMPLE_SCALE);
  output_samples.values[output_frame * parameters.channels + channel] = sum;
}
