/* Setup only.  Convolving a chain of FIR responses into one composite is a
 * product in the frequency domain, so the host transforms each response in
 * turn and runs this once per response after the first, accumulating in
 * place.  It is double-double because every later block is convolved with
 * the composite, so its error is paid on every sample.
 *
 * Bindings, in the order the fusion path in fir_vulkan.c writes them; set 0
 * is implicit, being the only set:
 *   0 input_spectrum        -- in: the response just transformed.
 *   1 accumulated_spectrum  -- in/out: the composite so far, seeded with the
 *                              first response and multiplied in place.
 *
 * Push constant: spectrum_bins, the bin count of both buffers, fft_size / 2
 * + 1 for a transform large enough to hold the composite without circular
 * aliasing.  One response at a time, no channel axis.
 *
 * One invocation per bin, in workgroups of 256, hence the bounds test.  Each
 * invocation owns one accumulator element, so the in-place update needs no
 * synchronisation within the dispatch; the host places a barrier between
 * successive responses.
 */

#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

#include "double_double.glsl"

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer InputSpectrum {
  DoubleDoubleComplex values[];
} input_spectrum;

layout(std430, binding = 1) buffer AccumulatedSpectrum {
  DoubleDoubleComplex values[];
} accumulated_spectrum;

layout(push_constant) uniform Parameters {
  uint spectrum_bins;
} parameters;

void main()
{
  const uint index = gl_GlobalInvocationID.x;

  if (index < parameters.spectrum_bins) {
    const DoubleDoubleComplex first = accumulated_spectrum.values[index];
    const DoubleDoubleComplex second = input_spectrum.values[index];
    DoubleDoubleComplex result;

    result = multiply_complex_dd(first, second);
    accumulated_spectrum.values[index] = result;
  }
}
