#version 450

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer Coefficients {
  float coefficients[];
};

layout(std430, binding = 1) readonly buffer InputSamples {
  float input_samples[];
};

layout(std430, binding = 2) writeonly buffer OutputSamples {
  float output_samples[];
};

layout(push_constant) uniform Parameters {
  uint output_frames;
  uint phase_count;
  uint phase_step;
  uint phase_start;
  uint taps;
  uint channels;
  uint normalize;
  uint symmetric_presum;
} parameters;

const float SOX_SAMPLE_SCALE = 1.0 / 2147483647.0;

vec2 two_sum(float left, float right)
{
  precise float high = left + right;
  precise float right_virtual = high - left;
  precise float low = (left - (high - right_virtual)) + (right - right_virtual);

  return vec2(high, low);
}

vec2 add_float_float(vec2 left, vec2 right)
{
  precise vec2 sum = two_sum(left.x, right.x);
  precise float low = left.y + right.y + sum.y;

  return two_sum(sum.x, low);
}

void main()
{
  uint output_frame = gl_GlobalInvocationID.x;
  uint channel = gl_GlobalInvocationID.y;

  if (output_frame >= parameters.output_frames || channel >= parameters.channels)
    return;

  uint position = parameters.phase_start + output_frame * parameters.phase_step;
  uint input_base = position / parameters.phase_count;
  uint phase = position % parameters.phase_count;
  float scale = parameters.normalize != 0u ? SOX_SAMPLE_SCALE : 1.0;
  precise vec2 sum = vec2(0.0);

  if (parameters.symmetric_presum != 0u) {
    uint center = parameters.taps / 2u;
    float center_coefficient = coefficients[center];
    float center_input = input_samples[(input_base + center) * parameters.channels + channel];
    precise float product = center_coefficient * center_input;
    precise float residual = fma(center_coefficient, center_input, -product);

    sum = vec2(product, residual);
    for (uint tap = 0u; tap < center; ++tap) {
      float coefficient = coefficients[tap];

      if (coefficient != 0.0) {
        float input_value =
            input_samples[
                (input_base + tap) *
                parameters.channels + channel] +
            input_samples[
                (input_base + parameters.taps - 1u - tap) *
                parameters.channels + channel];

        product = coefficient * input_value;
        residual = fma(coefficient, input_value, -product);
        sum = add_float_float(sum, vec2(product, residual));
      }
    }
  }
  else {
    for (uint tap = 0u; tap < parameters.taps; ++tap) {
      float coefficient = coefficients[tap * parameters.phase_count + phase];
      float input_value = input_samples[(input_base + tap) * parameters.channels + channel];
      precise float product = coefficient * input_value;
      precise float residual = fma(coefficient, input_value, -product);

      sum = add_float_float(sum, vec2(product, residual));
    }
  }
  output_samples[output_frame * parameters.channels + channel] = (sum.x + sum.y) * scale;
}
