prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@SOX_PC_LIBDIR@
includedir=@SOX_PC_INCLUDEDIR@

Name: SoX
Description: Audio file format and effects library
Version: @PROJECT_VERSION@
URL: http://sox.sourceforge.net
Requires.private: @SOX_PC_REQUIRES_PRIVATE@
Libs: -L${libdir} -lsox
Libs.private: @SOX_PC_LIBS_PRIVATE@
Cflags: -I${includedir}
