/* The reference profile's member of the select family; rate_select_f64.comp
 * carries the family's rationale.  Every sample is a double-double pair, and
 * the normalisation goes through multiply_dd_scalar: 1/2147483647 is not
 * representable, so its product carries a residual the pair has to keep, and
 * dropping it would put a plain FP64 rounding back into the one profile whose
 * job is not to have any.
 *
 * Bindings, in the order run_resident_selection() in rate_vulkan.c writes
 * them:
 *   0 input_samples   -- in: the filtered block, planar.
 *   1 output_samples  -- out: the decimated block, interleaved.
 *
 * Push constants (select_parameters_t, 24 bytes): output_frames,
 * first_input_frame, input_step, input_channel_stride, channels and normalize.
 * first_input_frame and input_step together carry the
 * decimation phase across block boundaries.
 *
 * Dispatch is two-dimensional, x over output_frames in workgroups of 128 and
 * y one invocation per channel, hence both bounds tests.
 */

#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

#include "double_double.glsl"

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer InputSamples {
  dvec2 values[];
} input_samples;

layout(std430, binding = 1) writeonly buffer OutputSamples {
  dvec2 values[];
} output_samples;

layout(push_constant) uniform Parameters {
  uint output_frames;
  uint first_input_frame;
  uint input_step;
  uint input_channel_stride;
  uint channels;
  uint normalize;
} parameters;

const double SOX_SAMPLE_SCALE = 1.0 / 2147483647.0;

void main()
{
  const uint output_frame = gl_GlobalInvocationID.x;
  const uint channel = gl_GlobalInvocationID.y;

  if (output_frame >= parameters.output_frames || channel >= parameters.channels)
    return;

  const uint input_frame = parameters.first_input_frame + output_frame * parameters.input_step;
  dvec2 value = input_samples.values[channel * parameters.input_channel_stride + input_frame];

  if (parameters.normalize != 0u)
    value = multiply_dd_scalar(value, SOX_SAMPLE_SCALE);
  output_samples.values[output_frame * parameters.channels + channel] = value;
}
