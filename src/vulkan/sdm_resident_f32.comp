/* Convert a resident FP32 interleaved stream to the planar FP32 layout used
 * by the Vulkan SDM modulator.
 *
 * This is the ingest step of the resident DSD path: a single dispatch
 * transposes interleaved to planar, folds the producer's domain in through
 * scale, and zero-fills the tail up to the fixed block the modulator's
 * finite-state machine requires.  The modulator
 * is FP32, so every member of this family writes plain floats however wide
 * its input is.
 *
 * Bindings, in the order update_resident_descriptors() in sdm_vulkan.c writes
 * them:
 *   0 input_samples    -- in: the producer's block, interleaved.
 *   1 output_samples   -- out: the modulator's input buffer, planar, one
 *                         whole channel of output_frames at a time.
 *   2 clipped_samples  -- in/out: a single counter, incremented atomically
 *                         for every sample outside full scale.
 *
 * Push constants (resident_parameters_t, 16 bytes):
 *   input_frames   frames the producer actually supplied.
 *   output_frames  frames the modulator's block holds; the difference is the
 *                  silence padding, and also the planar channel stride.
 *   channels       channels, and the interleaved input's frame stride.
 *   scale          the producer's domain as a factor: one for a normalized
 *                  stream; for a sox_sample stream, one or 1/2^31 as
 *                  ensure_resident_pipeline() in sdm_vulkan.c decides.
 *
 * Dispatch is two-dimensional: x covers output_frames, padding included,
 * rounded up to whole workgroups of 128, and y is one invocation per
 * channel, hence both bounds tests.  Each invocation writes one distinct
 * output element; the clip counter is the only shared state, which is why
 * that write is atomic.
 *
 * Out-of-range values are counted and passed through unchanged; the
 * modulator's quantize_input() applies the input gain and clamps.
 *
 * Input is plain FP32, the same width as the modulator, so the conversion is
 * one multiply.
 */

#version 450

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer InputSamples {
  float input_samples[];
};

layout(std430, binding = 1) writeonly buffer OutputSamples {
  float output_samples[];
};

layout(std430, binding = 2) buffer ClipCounter {
  uint clipped_samples[];
};

layout(push_constant) uniform Parameters {
  uint input_frames;
  uint output_frames;
  uint channels;
  float scale;
} parameters;

void main()
{
  uint frame = gl_GlobalInvocationID.x;
  uint channel = gl_GlobalInvocationID.y;

  if (frame >= parameters.output_frames || channel >= parameters.channels)
    return;

  float value = 0.0;
  if (frame < parameters.input_frames) {
    value = input_samples[frame * parameters.channels + channel] * parameters.scale;
  }
  if (value < -1.0 || value > 1.0)
    atomicAdd(clipped_samples[0], 1u);
  output_samples[channel * parameters.output_frames + frame] = value;
}
