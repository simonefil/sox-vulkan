#version 450
#extension GL_ARB_gpu_shader_fp64 : require

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer Coefficients {
  double coefficients[];
};

layout(std430, binding = 1) readonly buffer InputSamples {
  double input_samples[];
};

layout(std430, binding = 2) writeonly buffer OutputSamples {
  double output_samples[];
};

layout(push_constant) uniform Parameters {
  uint output_frames;
  uint phase_count;
  uint phase_step;
  uint phase_start;
  uint taps;
  uint channels;
  uint normalize;
  uint symmetric_presum;
} parameters;

const double SOX_SAMPLE_SCALE = 1.0 / 2147483647.0;

void main()
{
  uint output_frame = gl_GlobalInvocationID.x;
  uint channel = gl_GlobalInvocationID.y;
  if (output_frame >= parameters.output_frames || channel >= parameters.channels)
    return;

  uint position = parameters.phase_start + output_frame * parameters.phase_step;
  uint input_base = position / parameters.phase_count;
  uint phase = position % parameters.phase_count;
  double scale = parameters.normalize != 0u ? SOX_SAMPLE_SCALE : 1.0;
  double sum = 0.0;
  if (parameters.symmetric_presum != 0u) {
    uint center = parameters.taps / 2u;

    sum = coefficients[center] * input_samples[(input_base + center) * parameters.channels + channel];
    for (uint tap = 0u; tap < center; ++tap)
      if (coefficients[tap] != 0.0)
        sum += (input_samples[
            (input_base + tap) *
            parameters.channels + channel] +
            input_samples[
            (input_base + parameters.taps - 1u - tap) *
            parameters.channels + channel]) *
            coefficients[tap];
  }
  else
    for (uint tap = 0u; tap < parameters.taps; ++tap)
      sum += coefficients[tap * parameters.phase_count + phase] *
          input_samples[
              (input_base + tap) *
              parameters.channels + channel];
  output_samples[output_frame * parameters.channels + channel] = sum * scale;
}
