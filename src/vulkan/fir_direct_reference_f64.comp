#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer Input {
  double values[];
} input_samples;

layout(set = 0, binding = 1, std430) buffer Output {
  double values[];
} output_samples;

layout(set = 0, binding = 2, std430) readonly buffer Coefficients {
  double values[];
} coefficients;

layout(push_constant) uniform Parameters {
  uint taps;
  uint block_frames;
  uint channels;
  uint stride;
} parameters;

void main()
{
  const uint index = gl_GlobalInvocationID.x;

  if (index < parameters.channels * parameters.block_frames) {
    const uint channel = index / parameters.block_frames;
    const uint frame = index % parameters.block_frames;
    const uint input_base = channel * parameters.stride;
    const uint output_base = channel * parameters.stride;
    const uint position = parameters.block_frames + frame;
    double sum = 0.0;
    double correction = 0.0;

    for (uint tap = 0; tap < parameters.taps; ++tap) {
      const double product =
          input_samples.values[input_base + position - tap] *
          coefficients.values[tap];
      const double adjusted = product - correction;
      const double next = sum + adjusted;

      correction = (next - sum) - adjusted;
      sum = next;
    }
    output_samples.values[output_base + frame] = sum;
  }
}
