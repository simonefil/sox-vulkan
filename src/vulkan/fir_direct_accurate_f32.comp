#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer Input {
  float values[];
} input_samples;

layout(set = 0, binding = 1, std430) buffer Output {
  float values[];
} output_samples;

layout(set = 0, binding = 2, std430) readonly buffer CoefficientsHigh {
  float values[];
} coefficients_high;

layout(set = 0, binding = 3, std430) readonly buffer CoefficientsLow {
  float values[];
} coefficients_low;

layout(push_constant) uniform Parameters {
  uint taps;
  uint block_frames;
  uint channels;
  uint stride;
} parameters;

vec2 two_sum(float left, float right)
{
  precise float high = left + right;
  precise float right_virtual = high - left;
  precise float low =
      (left - (high - right_virtual)) +
      (right - right_virtual);

  return vec2(high, low);
}

vec2 add_float_float(vec2 left, vec2 right)
{
  precise vec2 sum = two_sum(left.x, right.x);
  precise float low = left.y + right.y + sum.y;
  precise vec2 normalized = two_sum(sum.x, low);

  return normalized;
}

vec2 multiply_float_float(vec2 value, vec2 coefficient)
{
  precise float product = value.x * coefficient.x;
  precise float residual =
      fma(value.x, coefficient.x, -product) +
      value.x * coefficient.y +
      value.y * coefficient.x;

  return vec2(product, residual);
}

void main()
{
  const uint index = gl_GlobalInvocationID.x;

  if (index < parameters.channels * parameters.block_frames) {
    const uint channel = index / parameters.block_frames;
    const uint frame = index % parameters.block_frames;
    const uint input_base = channel * parameters.stride;
    const uint input_low_base =
        parameters.channels * parameters.stride +
        input_base;
    const uint output_base = channel * parameters.stride;
    const uint position = parameters.block_frames + frame;
    precise vec2 sum = vec2(0.0);

    for (uint tap = 0; tap < parameters.taps; ++tap) {
      const uint input_index = position - tap;
      precise vec2 value = vec2(
          input_samples.values[input_base + input_index],
          input_samples.values[input_low_base + input_index]);
      sum = add_float_float(
          sum,
          multiply_float_float(
              value,
              vec2(
                  coefficients_high.values[tap],
                  coefficients_low.values[tap])));
    }
    output_samples.values[output_base + frame] =
        sum.x + sum.y;
  }
}
