#version 450
#extension GL_ARB_gpu_shader_fp64 : require

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer InputSamples {
  double input_samples[];
};

layout(std430, binding = 1) buffer StreamSamples {
  float stream_samples[];
};

layout(std430, binding = 2) buffer PreparedSamples {
  float prepared_samples[];
};

layout(std430, binding = 3) buffer HistorySamples {
  float history_samples[];
};

layout(std430, binding = 4) buffer ClipCounter {
  uint clipped_samples[];
};

layout(std430, binding = 5) writeonly buffer RetainedSamples {
  float retained_samples[];
};

layout(push_constant) uniform Parameters {
  uint mode;
  uint input_base_element;
  uint output_first_frame;
  uint frames;
  uint input_frame_stride;
  uint input_channel_stride;
  uint channels;
  uint core_frames;
  uint available_frames;
  uint remaining_frames;
  uint padded_frames;
  uint padding_frames;
  uint clip_index;
  uint padding0;
  uint padding1;
  uint padding2;
} parameters;

const uint MODE_APPEND = 0u;
const uint MODE_PREPARE = 1u;
const uint MODE_RETIRE = 2u;

void main()
{
  uint frame = gl_GlobalInvocationID.x;
  uint channel = gl_GlobalInvocationID.y;
  if (channel >= parameters.channels)
    return;

  if (parameters.mode == MODE_APPEND) {
    if (frame >= parameters.frames)
      return;
    uint input_index = parameters.input_base_element +
        frame * parameters.input_frame_stride +
        channel * parameters.input_channel_stride;
    uint output_index =
        (parameters.output_first_frame + frame) *
        parameters.channels + channel;
    double value = roundEven(input_samples[input_index]);
    if (value < -2147483648.0 || value > 2147483647.0)
      atomicAdd(clipped_samples[parameters.clip_index], 1u);
    value = clamp(value, -2147483648.0, 2147483647.0);
    stream_samples[output_index] =
        float(value / 2147483648.0);
    return;
  }

  if (parameters.mode == MODE_PREPARE) {
    if (frame >= parameters.padded_frames)
      return;
    uint output_index =
        channel * parameters.padded_frames + frame;
    if (frame < parameters.padding_frames)
      prepared_samples[output_index] =
          history_samples[
              channel * parameters.padding_frames + frame];
    else {
      uint input_frame = frame - parameters.padding_frames;
      prepared_samples[output_index] =
          input_frame < parameters.available_frames ?
          stream_samples[
              input_frame * parameters.channels + channel] : 0.0;
    }
    return;
  }

  if (parameters.mode == MODE_RETIRE) {
    if (frame < parameters.padding_frames)
      history_samples[
          channel * parameters.padding_frames + frame] =
          prepared_samples[
              channel * parameters.padded_frames +
              parameters.core_frames + frame];
    if (frame < parameters.remaining_frames)
      retained_samples[
          frame * parameters.channels + channel] =
          stream_samples[
              (parameters.core_frames + frame) *
              parameters.channels + channel];
  }
}
