/* Double-double cubic interpolation for the reference profile. */

#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

#include "double_double.glsl"

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer InputSamples {
  dvec2 values[];
} input_samples;

layout(std430, binding = 1) writeonly buffer OutputSamples {
  dvec2 values[];
} output_samples;

layout(push_constant) uniform Parameters {
  uint output_frames;
  uint step_integer;
  uint step_fraction;
  uint phase_fraction;
  uint channels;
  uint padding0;
  uint padding1;
  uint padding2;
} parameters;

void main()
{
  const uint output_frame = gl_GlobalInvocationID.x;
  const uint channel = gl_GlobalInvocationID.y;
  uint product_high;
  uint product_low;
  uint fraction;
  uint carry;
  uint input_frame;

  if (output_frame >= parameters.output_frames || channel >= parameters.channels)
    return;

  umulExtended(output_frame, parameters.step_fraction, product_high, product_low);
  fraction = parameters.phase_fraction + product_low;
  carry = fraction < product_low ? 1u : 0u;
  input_frame = 1u + output_frame * parameters.step_integer + product_high + carry;
  precise double x_high = double(fraction) * (1.0 / 4294967296.0);
  const dvec2 x = dvec2(x_high, 0.0);
  const dvec2 sample_m1 = input_samples.values[(input_frame - 1u) * parameters.channels + channel];
  const dvec2 sample_0 = input_samples.values[input_frame * parameters.channels + channel];
  const dvec2 sample_1 = input_samples.values[(input_frame + 1u) * parameters.channels + channel];
  const dvec2 sample_2 = input_samples.values[(input_frame + 2u) * parameters.channels + channel];
  const dvec2 b = subtract_dd(multiply_dd(add_dd(sample_1, sample_m1), dvec2(0.5, 0.0)), sample_0);
  dvec2 a = subtract_dd(sample_2, sample_1);

  a = add_dd(a, sample_m1);
  a = subtract_dd(a, sample_0);
  a = subtract_dd(a, multiply_dd(b, dvec2(4.0, 0.0)));
  a = multiply_dd(a, dvec2(0.16666666666666666, 9.2518585385429707e-18));
  const dvec2 c = subtract_dd(subtract_dd(subtract_dd(sample_1, sample_0), a), b);
  const dvec2 value = add_dd(multiply_dd(add_dd(multiply_dd(add_dd(multiply_dd(a, x), b), x), c), x), sample_0);

  output_samples.values[output_frame * parameters.channels + channel] = value;
}
