/* rate_polyphase_f64.comp with an FP32 output, and the reason it exists is
 * the mismatch in the name: the accumulation is FP64 but the resident buffer
 * it writes is FP32.
 *
 * The host selects this when the stage is FP64 internally and the consumer
 * wants normalized FP32 samples, which is a narrowing the plain FP64 shader
 * cannot do -- its output binding is typed double.
 *
 * The normalize push constant follows the same rule as rate_select_*.comp:
 * the host sets it only when the consumer wants normalized output and the
 * build's sample representation is not already normalized.  The conditional
 * scale therefore avoids applying SOX_SAMPLE_SCALE twice on such builds.
 *
 * Bindings, in the order rate_polyphase_vulkan.c writes them:
 *   0 coefficients    -- in: the response, tap major, phase minor, FP64.
 *   1 input_samples   -- in: interleaved input frames, FP64.
 *   2 output_samples  -- out: interleaved output frames, FP32 and normalized.
 *
 * Push constants (parameters_t, 32 bytes): output_frames, phase_count,
 * phase_step, phase_start, taps, channels, normalize (whether to scale),
 * symmetric_presum.  The counter's quotient by phase_count is the input frame
 * and its remainder the sub-filter; see the FP64 shader.
 *
 * Dispatch is two-dimensional, x over the output frames in workgroups of 128
 * and y one invocation per channel, hence both bounds tests.
 */

#version 450
#extension GL_ARB_gpu_shader_fp64 : require

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer Coefficients {
  double coefficients[];
};

layout(std430, binding = 1) readonly buffer InputSamples {
  double input_samples[];
};

layout(std430, binding = 2) writeonly buffer OutputSamples {
  float output_samples[];
};

layout(push_constant) uniform Parameters {
  uint output_frames;
  uint phase_count;
  uint phase_step;
  uint phase_start;
  uint taps;
  uint channels;
  uint normalize;
  uint symmetric_presum;
} parameters;

const double SOX_SAMPLE_SCALE = 1.0 / 2147483647.0;

void main()
{
  uint output_frame = gl_GlobalInvocationID.x;
  uint channel = gl_GlobalInvocationID.y;
  if (output_frame >= parameters.output_frames || channel >= parameters.channels)
    return;

  uint position = parameters.phase_start + output_frame * parameters.phase_step;
  uint input_base = position / parameters.phase_count;
  uint phase = position % parameters.phase_count;
  double sum = 0.0;

  /* The symmetric form: a linear-phase response has coefficient[tap] equal to
   * coefficient[taps - 1 - tap], so the mirrored input pair can be added
   * before the one multiply, halving them.  The host only sets this for a
   * response that really is symmetric, and it also requires phase_count == 1
   * and an odd tap count, which is why the coefficient index has no phase
   * term.  The zero test skips the exact zeros of a half-band response. */
  if (parameters.symmetric_presum != 0u) {
    uint center = parameters.taps / 2u;

    sum = coefficients[center] * input_samples[(input_base + center) * parameters.channels + channel];
    for (uint tap = 0u; tap < center; ++tap)
      if (coefficients[tap] != 0.0)
        sum += (input_samples[
            (input_base + tap) *
            parameters.channels + channel] +
            input_samples[
            (input_base + parameters.taps - 1u - tap) *
            parameters.channels + channel]) *
            coefficients[tap];
  }
  else
    for (uint tap = 0u; tap < parameters.taps; ++tap)
      sum += coefficients[tap * parameters.phase_count + phase] *
          input_samples[
              (input_base + tap) *
              parameters.channels + channel];
  double scale = parameters.normalize != 0u ? SOX_SAMPLE_SCALE : 1.0;
  output_samples[output_frame * parameters.channels + channel] = float(sum * scale);
}
