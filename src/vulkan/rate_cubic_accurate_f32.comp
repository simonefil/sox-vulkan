/* Compensated FP32 cubic interpolation for the accurate profile. */

#version 450

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer InputSamples {
  float input_samples[];
};

layout(std430, binding = 1) writeonly buffer OutputSamples {
  float output_samples[];
};

layout(push_constant) uniform Parameters {
  uint output_frames;
  uint step_integer;
  uint step_fraction;
  uint phase_fraction;
  uint channels;
  uint padding0;
  uint padding1;
  uint padding2;
} parameters;

vec2 two_sum(float left, float right)
{
  precise float high = left + right;
  precise float right_virtual = high - left;
  precise float low = (left - (high - right_virtual)) + (right - right_virtual);

  return vec2(high, low);
}

vec2 add_float_float(vec2 left, vec2 right)
{
  precise vec2 high_sum = two_sum(left.x, right.x);
  precise float low = left.y + right.y + high_sum.y;

  return two_sum(high_sum.x, low);
}

vec2 subtract_float_float(vec2 left, vec2 right)
{
  return add_float_float(left, -right);
}

vec2 multiply_float_float(vec2 left, vec2 right)
{
  precise float product = left.x * right.x;
  precise float residual = fma(left.x, right.x, -product) + left.x * right.y + left.y * right.x;

  return two_sum(product, residual);
}

vec2 fraction_float_float(uint fraction)
{
  const uint high = fraction >> 16u;
  const uint low = fraction & 65535u;

  return vec2(float(high) * (1.0 / 65536.0), float(low) * (1.0 / 4294967296.0));
}

void main()
{
  const uint output_frame = gl_GlobalInvocationID.x;
  const uint channel = gl_GlobalInvocationID.y;
  uint product_high;
  uint product_low;
  uint fraction;
  uint carry;
  uint input_frame;

  if (output_frame >= parameters.output_frames || channel >= parameters.channels)
    return;

  umulExtended(output_frame, parameters.step_fraction, product_high, product_low);
  fraction = parameters.phase_fraction + product_low;
  carry = fraction < product_low ? 1u : 0u;
  input_frame = 1u + output_frame * parameters.step_integer + product_high + carry;
  const vec2 x = fraction_float_float(fraction);
  const vec2 sample_m1 = vec2(input_samples[(input_frame - 1u) * parameters.channels + channel], 0.0);
  const vec2 sample_0 = vec2(input_samples[input_frame * parameters.channels + channel], 0.0);
  const vec2 sample_1 = vec2(input_samples[(input_frame + 1u) * parameters.channels + channel], 0.0);
  const vec2 sample_2 = vec2(input_samples[(input_frame + 2u) * parameters.channels + channel], 0.0);
  const vec2 b = subtract_float_float(
      multiply_float_float(
          add_float_float(sample_1, sample_m1),
          vec2(0.5, 0.0)),
      sample_0);
  vec2 a = subtract_float_float(sample_2, sample_1);

  a = add_float_float(a, sample_m1);
  a = subtract_float_float(a, sample_0);
  a = subtract_float_float(a, multiply_float_float(b, vec2(4.0, 0.0)));
  a = multiply_float_float(a, vec2(0.1666666716337204, -4.967053879312289e-9));
  const vec2 c = subtract_float_float(subtract_float_float(subtract_float_float(sample_1, sample_0), a), b);
  const vec2 value = add_float_float(
      multiply_float_float(
          add_float_float(
              multiply_float_float(
                  add_float_float(
                      multiply_float_float(a, x), b),
                  x),
              c),
          x),
      sample_0);

  output_samples[output_frame * parameters.channels + channel] = value.x + value.y;
}
