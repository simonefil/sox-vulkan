/* The reference profile's member of the prepare family; rate_prepare_f64.comp
 * carries the family's rationale.  Every sample is a double-double pair, so
 * the up_factor gain goes through multiply_dd_scalar rather than a plain
 * multiply: the factor is a small integer and therefore exact, but the
 * product's low word still has to be carried or the pair silently collapses
 * to its high word.  double_double.glsl states the rules that keep the
 * compiler from folding it away.
 *
 * Bindings, in the order record_resident_prepare() in rate_vulkan.c writes
 * them:
 *   0 input_samples     -- in: the producer's resident block, bound at its
 *                          own offset and read through its own strides.
 *   1 prepared_samples  -- out: the FIR's prepared input, planar, two blocks
 *                          per channel.
 *   2 previous_samples  -- in/out: the overlap carried between blocks.
 *
 * Push constants (prepare_parameters_t, 28 bytes): block_frames,
 * input_frames, input_frame_stride, input_channel_stride,
 * prepared_channel_stride, up_factor and channels.
 *
 * Dispatch is two-dimensional, x over block_frames in workgroups of 128 and
 * y one invocation per channel, hence both bounds tests; an invocation owns
 * one (channel, frame), so nothing here synchronises.
 */

#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

#include "double_double.glsl"

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer InputSamples {
  dvec2 values[];
} input_samples;

layout(std430, binding = 1) writeonly buffer PreparedSamples {
  dvec2 values[];
} prepared_samples;

layout(std430, binding = 2) buffer PreviousSamples {
  dvec2 values[];
} previous_samples;

layout(push_constant) uniform Parameters {
  uint block_frames;
  uint input_frames;
  uint input_frame_stride;
  uint input_channel_stride;
  uint prepared_channel_stride;
  uint up_factor;
  uint channels;
} parameters;

void main()
{
  const uint frame = gl_GlobalInvocationID.x;
  const uint channel = gl_GlobalInvocationID.y;

  if (frame >= parameters.block_frames || channel >= parameters.channels)
    return;

  const uint previous_index = channel * parameters.block_frames + frame;
  const uint prepared_index = channel * parameters.prepared_channel_stride + frame;
  dvec2 value = dvec2(0.0);

  if (frame % parameters.up_factor == 0u) {
    const uint input_frame = frame / parameters.up_factor;

    if (input_frame < parameters.input_frames)
      value = multiply_dd_scalar(
          input_samples.values[
              input_frame * parameters.input_frame_stride +
              channel * parameters.input_channel_stride],
          double(parameters.up_factor));
  }
  prepared_samples.values[prepared_index] = previous_samples.values[previous_index];
  prepared_samples.values[prepared_index + parameters.block_frames] = value;
  previous_samples.values[previous_index] = value;
}
