/* The ingest step of the resident DSD path: one dispatch that transposes,
 * scales and pads a producer's block into what sdm_mash2_fsm.comp expects.
 *
 * Three things happen at once because they are all one read and one write:
 * the layout goes interleaved to planar, the producer's domain is folded in
 * through scale, and the tail is zero-filled up to the fixed block the
 * modulator's finite-state machine requires.  The modulator itself is always
 * FP32, which is why every member of this family writes plain floats however
 * wide its input is.
 *
 * Bindings, in the order update_resident_descriptors() in sdm_vulkan.c writes
 * them:
 *   0 input_samples    -- in: the producer's block, interleaved.
 *   1 output_samples   -- out: the modulator's input buffer, planar, one
 *                         whole channel of output_frames at a time.
 *   2 clipped_samples  -- in/out: a single counter, incremented atomically
 *                         for every sample outside full scale.
 *
 * Push constants (resident_parameters_t, 16 bytes):
 *   input_frames   frames the producer actually supplied.
 *   output_frames  frames the modulator's block holds; the difference is the
 *                  silence padding, and also the planar channel stride.
 *   channels       channels, and the interleaved input's frame stride.
 *   scale          the producer's domain as a factor: one for a normalized
 *                  stream, 1/2^31 for a sox_sample stream.
 *
 * Dispatch is two-dimensional: x covers output_frames -- not input_frames, so
 * the padding is written rather than left stale -- rounded up to whole
 * workgroups of 128, and y is one invocation per channel, hence both bounds
 * tests.  Each invocation writes one distinct output element; the clip
 * counter is the only shared state, which is why that write is atomic.
 *
 * Out-of-range values are counted and passed through, not clamped: the
 * modulator's own input gain is what keeps its loop in range, and clamping
 * here would hide an input that is already too hot.
 *
 * Input is FP64 and narrows to FP32 here, at the boundary where the
 * modulator's precision begins.
 */

#version 450
#extension GL_ARB_gpu_shader_fp64 : require

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer InputSamples {
  double input_samples[];
};

layout(std430, binding = 1) writeonly buffer OutputSamples {
  float output_samples[];
};

layout(std430, binding = 2) buffer ClipCounter {
  uint clipped_samples[];
};

layout(push_constant) uniform Parameters {
  uint input_frames;
  uint output_frames;
  uint channels;
  float scale;
} parameters;

void main()
{
  uint frame = gl_GlobalInvocationID.x;
  uint channel = gl_GlobalInvocationID.y;

  if (frame >= parameters.output_frames || channel >= parameters.channels)
    return;

  float value = 0.0;
  if (frame < parameters.input_frames) {
    double value64 = input_samples[frame * parameters.channels + channel];

    value = float(value64 * double(parameters.scale));
  }
  if (value < -1.0 || value > 1.0)
    atomicAdd(clipped_samples[0], 1u);
  output_samples[channel * parameters.output_frames + frame] = value;
}
