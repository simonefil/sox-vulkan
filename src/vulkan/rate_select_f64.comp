 * your option) any later version.
 */

#version 450
#extension GL_ARB_gpu_shader_fp64 : require

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer InputSamples {
  double input_samples[];
};

layout(std430, binding = 1) writeonly buffer OutputSamples {
  double output_samples[];
};

layout(push_constant) uniform Parameters {
  uint output_frames;
  uint first_input_frame;
  uint input_step;
  uint input_channel_stride;
  uint channels;
  uint normalize;
  uint padding1;
  uint padding2;
} parameters;

const double SOX_SAMPLE_SCALE = 1.0 / 2147483647.0;

void main()
{
  uint output_frame = gl_GlobalInvocationID.x;
  uint channel = gl_GlobalInvocationID.y;
  if (output_frame >= parameters.output_frames || channel >= parameters.channels)
    return;

  uint input_frame = parameters.first_input_frame + output_frame * parameters.input_step;
  double scale = parameters.normalize != 0u ? SOX_SAMPLE_SCALE : 1.0;
  output_samples[output_frame * parameters.channels + channel] = input_samples[channel * parameters.input_channel_stride + input_frame] * scale;
}
