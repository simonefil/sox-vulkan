/* Partitioned overlap-save convolution, FP64 with compensated summation.
 *
 * The strict and reference profiles reach this through precise_fp64.  It
 * differs from fir_partition_f64.comp only in the accumulator: the partition
 * sum is carried with a Kahan correction term, which matters because the sum
 * runs over every partition of the response and the bins with the largest
 * magnitudes dominate the earlier terms.  The products themselves are still
 * plain FP64; only their accumulation is compensated.
 *
 * Bindings, in the order create_partition_pipeline() writes them:
 *   0 working  -- out: this block's accumulated spectrum.
 *   1 history  -- in: ring of the last `partitions` input spectra per channel.
 *   2 kernels  -- in: the transformed response, partition-major.
 *
 * Push constants (partition_parameters_t, 16 bytes): spectrum_bins,
 * partitions, channels, current_slot.
 *
 * Dispatch covers channels * spectrum_bins invocations rounded up to whole
 * workgroups of 256, hence the bounds test.
 */

#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) buffer Working {
  dvec2 values[];
} working;

layout(set = 0, binding = 1, std430) buffer History {
  dvec2 values[];
} history;

layout(set = 0, binding = 2, std430) readonly buffer Kernels {
  dvec2 values[];
} kernels;

layout(push_constant) uniform Parameters {
  uint spectrum_bins;
  uint partitions;
  uint channels;
  uint current_slot;
} parameters;

void main()
{
  const uint index = gl_GlobalInvocationID.x;

  if (index < parameters.channels * parameters.spectrum_bins) {
    const uint bin = index % parameters.spectrum_bins;
    const uint channel = index / parameters.spectrum_bins;
    dvec2 sum = dvec2(0.0);
    dvec2 correction = dvec2(0.0);

    for (uint part = 0; part < parameters.partitions; ++part) {
      const uint slot = (parameters.current_slot + parameters.partitions - part) % parameters.partitions;
      const dvec2 value = history.values[(channel * parameters.partitions + slot) * parameters.spectrum_bins + bin];
      const dvec2 coefficient = kernels.values[(part * parameters.channels + channel) * parameters.spectrum_bins + bin];
      const dvec2 product = dvec2(
          value.x * coefficient.x - value.y * coefficient.y,
          value.x * coefficient.y + value.y * coefficient.x);
      /* Kahan: fold in the residual the previous addition lost, then recover
       * what this one loses.  Both components are carried independently. */
      const dvec2 adjusted = product - correction;
      const dvec2 next = sum + adjusted;

      correction = (next - sum) - adjusted;
      sum = next;
    }
    working.values[index] = sum;
  }
}
