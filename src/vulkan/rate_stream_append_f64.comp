/* Append a producer's block to the rate stage's input stream.
 *
 * A resident producer's block size need not match what this stage consumes,
 * so blocks accumulate in a stream buffer until a whole one is there.  When
 * the input is already interleaved with unit strides and needs no
 * quantisation, append_resident_stream() in rate_vulkan.c does a plain buffer
 * copy instead and this shader never runs; it exists for the cases that need
 * gathering, rounding, or both.
 *
 * Bindings, in the order append_resident_stream() writes them:
 *   0 input_samples    -- in: the producer's buffer.  Bound whole, at offset
 *                         zero, unlike the prepare and select shaders: the
 *                         block's position arrives as input_base_element
 *                         instead, since a stream append may start anywhere.
 *   1 stream_samples   -- out: the stream buffer, interleaved.
 *   2 clipped_samples  -- in/out: one counter per stage, incremented
 *                         atomically when quantisation has to clamp.
 *
 * Push constants (stream_append_parameters_t, 32 bytes):
 *   input_base_element    element offset of the block within binding 0.
 *   output_first_frame    frame the block starts at in the stream, which is
 *                         the stream's occupancy before the append.
 *   frames                frames in the block.
 *   input_frame_stride    elements between consecutive input frames.
 *   input_channel_stride  elements between input channels.
 *   channels              channels, and the interleaved stream's frame
 *                         stride.
 *   quantize_sox_sample   round each sample to SoX's integer grid.
 *   clip_index            which counter in binding 2 this stage owns.
 *
 * Dispatch is two-dimensional: x covers frames rounded up to whole workgroups
 * of 128, y is one invocation per channel, hence both bounds tests.  Each
 * invocation writes one distinct stream element; the only shared state is the
 * clip counter, which is why that one write is atomic.
 *
 * Plain FP64.
 */

#version 450
#extension GL_ARB_gpu_shader_fp64 : require

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer InputSamples {
  double input_samples[];
};

layout(std430, binding = 1) writeonly buffer StreamSamples {
  double stream_samples[];
};

layout(std430, binding = 2) buffer ClipCounter {
  uint clipped_samples[];
};

layout(push_constant) uniform Parameters {
  uint input_base_element;
  uint output_first_frame;
  uint frames;
  uint input_frame_stride;
  uint input_channel_stride;
  uint channels;
  uint quantize_sox_sample;
  uint clip_index;
} parameters;

void main()
{
  uint frame = gl_GlobalInvocationID.x;
  uint channel = gl_GlobalInvocationID.y;
  if (frame >= parameters.frames || channel >= parameters.channels)
    return;

  uint input_index = parameters.input_base_element + frame * parameters.input_frame_stride + channel * parameters.input_channel_stride;
  uint output_index = (parameters.output_first_frame + frame) * parameters.channels + channel;
  double value = input_samples[input_index];
  /* roundEven is SoX's rounding rule for the integer sample grid; the clamp
   * saturates rather than wrapping, and the counter records that it had to,
   * so the effect can report clipping exactly as the CPU path does. */
  if (parameters.quantize_sox_sample != 0u) {
    value = roundEven(value);
    if (value < -2147483648.0 || value > 2147483647.0)
      atomicAdd(clipped_samples[parameters.clip_index], 1u);
    value = clamp(value, -2147483648.0, 2147483647.0);
  }
  stream_samples[output_index] = value;
}
