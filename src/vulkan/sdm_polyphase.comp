#version 450

layout(local_size_x = 128) in;

/*
 * Four adjacent DSD-rate samples are evaluated per invocation.  phase_step=1
 * is the common integer-upsample path: all four phases read the same PCM
 * sample and can share that load.  Rational L/M conversion uses the general
 * path because adjacent output phases can cross an input-sample boundary.
 *
 * Input contains a history prefix and a look-ahead suffix.  Coefficients are
 * stored tap-major so the four adjacent phases are contiguous in memory.
 */

layout(std430, binding = 0) readonly buffer Coefficients {
  float coefficients[];
};

layout(std430, binding = 1) readonly buffer InputSamples {
  float input_samples[];
};

layout(std430, binding = 2) writeonly buffer OutputSamples {
  vec4 output_samples[];
};

layout(push_constant) uniform Parameters {
  uint output_frames;
  uint padded_input_frames;
  uint phase_count;
  uint taps_per_phase;
  uint input_padding;
  uint channel_count;
  uint phase_step;
  uint phase_start;
} parameters;

void main()
{
  uint vector_index = gl_GlobalInvocationID.x;
  uint phases_per_vector = 4u;
  uint total_vectors = parameters.output_frames / phases_per_vector;
  if (vector_index >= total_vectors)
    return;

  uvec4 output_index =
      uvec4(vector_index * phases_per_vector) + uvec4(0u, 1u, 2u, 3u);
  uvec4 position =
      uvec4(parameters.phase_start) +
      output_index * uvec4(parameters.phase_step);
  uvec4 phase = position % uvec4(parameters.phase_count);
  uvec4 input_base = position / uvec4(parameters.phase_count);
  uint channel = gl_WorkGroupID.y;
  uint input_channel_base = channel * parameters.padded_input_frames;
  uint output_channel_base = channel * (parameters.output_frames / phases_per_vector);
  vec4 sum = vec4(0.0);

  if (parameters.phase_step == 1u) {
    uint vectors_per_input =
        parameters.phase_count / phases_per_vector;
    uint phase_vector = vector_index % vectors_per_input;
    uint first_phase = phase_vector * phases_per_vector;
    uint first_input_base = vector_index / vectors_per_input;

    for (uint slot = 0u;
         slot < parameters.taps_per_phase; ++slot) {
      int k = int(slot) - int(parameters.input_padding);
      uint input_index = uint(
          int(first_input_base) - k +
          int(parameters.input_padding));
      uint coefficient =
          slot * parameters.phase_count + first_phase;
      vec4 taps = vec4(
          coefficients[coefficient],
          coefficients[coefficient + 1u],
          coefficients[coefficient + 2u],
          coefficients[coefficient + 3u]);
      sum += taps *
          input_samples[input_channel_base + input_index];
    }
    output_samples[output_channel_base + vector_index] = sum;
    return;
  }

  for (uint slot = 0u;
       slot < parameters.taps_per_phase; ++slot) {
    int k = int(slot) - int(parameters.input_padding);
    uvec4 input_index = uvec4(ivec4(input_base) - ivec4(k) +
        ivec4(int(parameters.input_padding)));
    uvec4 coefficient =
        uvec4(slot * parameters.phase_count) + phase;
    vec4 taps = vec4(
        coefficients[coefficient.x],
        coefficients[coefficient.y],
        coefficients[coefficient.z],
        coefficients[coefficient.w]);
    if (all(equal(input_base, uvec4(input_base.x))))
      sum += taps *
          input_samples[input_channel_base + input_index.x];
    else {
      vec4 samples = vec4(
          input_samples[input_channel_base + input_index.x],
          input_samples[input_channel_base + input_index.y],
          input_samples[input_channel_base + input_index.z],
          input_samples[input_channel_base + input_index.w]);
      sum += taps * samples;
    }
  }
  output_samples[output_channel_base + vector_index] = sum;
}
