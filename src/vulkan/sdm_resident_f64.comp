/*
 * Convert a resident FP64 interleaved stream to the planar FP32 layout used by the Vulkan SDM modulator.
 *
 * Frames added for the fixed-size FSM blocks are explicit silence and do
 * not advance the logical stream.  The scale carries the producer's domain:
 * one for a normalized stream, 1/2^31 for a sox_sample stream.  Values
 * outside full scale are counted, not clamped: the modulator's own input
 * gain is what keeps the loop in range.
 *
 * This library is free software; you can redistribute it and/or modify it
 * under the terms of the GNU Lesser General Public License as published by
 * the Free Software Foundation; either version 2.1 of the License, or (at
 * your option) any later version.
 */

#version 450
#extension GL_ARB_gpu_shader_fp64 : require

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer InputSamples {
  double input_samples[];
};

layout(std430, binding = 1) writeonly buffer OutputSamples {
  float output_samples[];
};

layout(std430, binding = 2) buffer ClipCounter {
  uint clipped_samples[];
};

layout(push_constant) uniform Parameters {
  uint input_frames;
  uint output_frames;
  uint channels;
  float scale;
} parameters;

void main()
{
  uint frame = gl_GlobalInvocationID.x;
  uint channel = gl_GlobalInvocationID.y;

  if (frame >= parameters.output_frames || channel >= parameters.channels)
    return;

  float value = 0.0;
  if (frame < parameters.input_frames) {
    double value64 = input_samples[frame * parameters.channels + channel];

    value = float(value64 * double(parameters.scale));
  }
  if (value < -1.0 || value > 1.0)
    atomicAdd(clipped_samples[0], 1u);
  output_samples[channel * parameters.output_frames + frame] = value;
}
