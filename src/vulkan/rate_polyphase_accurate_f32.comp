/* Compensated FP32 rational polyphase stage for the accurate profile.
 *
 * The accurate profile's member of the polyphase family;
 * rate_polyphase_f64.comp carries the family's rationale.  The device has no
 * shaderFloat64, so the tap sum is carried as a float-float pair: each
 * product keeps its rounding error through fma, and the accumulation is
 * exact to the pair.  A long response is exactly where a plain FP32 sum
 * drifts, since every tap rounds again.
 *
 * Coefficients and samples cross the interface as plain floats and the result
 * is narrowed back with one add; only the accumulation is compensated, which
 * is what distinguishes this from the strict profile, where the pairs are the
 * interface.
 *
 * Bindings, in the order rate_polyphase_vulkan.c writes them:
 *   0 coefficients    -- in: the response, tap major, phase minor, floats.
 *   1 input_samples   -- in: interleaved input frames, floats.
 *   2 output_samples  -- out: interleaved output frames, floats.
 *
 * Push constants (parameters_t, 32 bytes): output_frames, phase_count,
 * phase_step, phase_start, taps, channels, normalize, symmetric_presum.  The
 * counter's quotient by phase_count is the input frame and its remainder the
 * sub-filter.
 *
 * Dispatch is two-dimensional, x over the output frames in workgroups of 128
 * and y one invocation per channel, hence both bounds tests.
 */

#version 450

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer Coefficients {
  float coefficients[];
};

layout(std430, binding = 1) readonly buffer InputSamples {
  float input_samples[];
};

layout(std430, binding = 2) writeonly buffer OutputSamples {
  float output_samples[];
};

layout(push_constant) uniform Parameters {
  uint output_frames;
  uint phase_count;
  uint phase_step;
  uint phase_start;
  uint taps;
  uint channels;
  uint normalize;
  uint symmetric_presum;
} parameters;

const float SOX_SAMPLE_SCALE = 1.0 / 2147483647.0;

/* Float-float primitives, the FP32 counterpart of double_double.glsl and
 * subject to its rules for the same reason: every compensation term is
 * algebraically zero, so each result lands in a `precise` local and no
 * primitive takes an out parameter.  Only the two the accumulation needs are
 * here; the products are formed inline with fma. */

/* Knuth: the error term is exactly representable, for any two operands. */
vec2 two_sum(float left, float right)
{
  precise float high = left + right;
  precise float right_virtual = high - left;
  precise float low = (left - (high - right_virtual)) + (right - right_virtual);

  return vec2(high, low);
}

vec2 add_float_float(vec2 left, vec2 right)
{
  precise vec2 sum = two_sum(left.x, right.x);
  precise float low = left.y + right.y + sum.y;

  return two_sum(sum.x, low);
}

void main()
{
  uint output_frame = gl_GlobalInvocationID.x;
  uint channel = gl_GlobalInvocationID.y;

  if (output_frame >= parameters.output_frames || channel >= parameters.channels)
    return;

  uint position = parameters.phase_start + output_frame * parameters.phase_step;
  uint input_base = position / parameters.phase_count;
  uint phase = position % parameters.phase_count;
  float scale = parameters.normalize != 0u ? SOX_SAMPLE_SCALE : 1.0;
  precise vec2 sum = vec2(0.0);

  /* The symmetric form: a linear-phase response has coefficient[tap] equal to
   * coefficient[taps - 1 - tap], so the mirrored input pair can be added
   * before the one multiply.  The host only sets this for a response that
   * really is symmetric, and it also requires phase_count == 1 and an odd tap
   * count, which is why the coefficient index has no phase term.  The zero
   * test skips the alternate taps of a half-band response, exactly zero by
   * construction.
   *
   * The presum itself is a plain FP32 add and is the one uncompensated step
   * in this shader: it rounds once per tap pair, where the products and the
   * accumulation do not.  The strict profile, whose inputs are already pairs,
   * does not have that rounding. */
  if (parameters.symmetric_presum != 0u) {
    uint center = parameters.taps / 2u;
    float center_coefficient = coefficients[center];
    float center_input = input_samples[(input_base + center) * parameters.channels + channel];
    precise float product = center_coefficient * center_input;
    precise float residual = fma(center_coefficient, center_input, -product);

    sum = vec2(product, residual);
    for (uint tap = 0u; tap < center; ++tap) {
      float coefficient = coefficients[tap];

      if (coefficient != 0.0) {
        float input_value =
            input_samples[
                (input_base + tap) *
                parameters.channels + channel] +
            input_samples[
                (input_base + parameters.taps - 1u - tap) *
                parameters.channels + channel];

        product = coefficient * input_value;
        residual = fma(coefficient, input_value, -product);
        sum = add_float_float(sum, vec2(product, residual));
      }
    }
  }
  else {
    for (uint tap = 0u; tap < parameters.taps; ++tap) {
      float coefficient = coefficients[tap * parameters.phase_count + phase];
      float input_value = input_samples[(input_base + tap) * parameters.channels + channel];
      precise float product = coefficient * input_value;
      precise float residual = fma(coefficient, input_value, -product);

      sum = add_float_float(sum, vec2(product, residual));
    }
  }
  /* Narrow, then scale: the pair existed to keep the tap sum from drifting,
   * and one rounding at the end is the least this can cost. */
  output_samples[output_frame * parameters.channels + channel] = (sum.x + sum.y) * scale;
}
