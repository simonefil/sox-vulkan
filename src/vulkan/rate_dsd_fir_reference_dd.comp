/* The reference profile's member of the fused DSD family;
 * rate_dsd_fir_f64.comp carries the family's rationale.  Coefficients and the
 * accumulator are double-double pairs and every step goes through
 * double_double.glsl, which states the rules that keep the compiler from
 * folding the low words away.  Nothing here rounds until the caller decides
 * to narrow.
 *
 * The accumulation needs the pair: a DSD64 response runs to tens of
 * thousands of taps (46803 at the default quality, 242199 at -z), all added
 * at unit magnitude, so a plain double accumulator
 * would spend its last bits on the sum's own rounding.  Negating a pair is
 * exact in both words, so a DSD frame costs one addition and no multiply.
 *
 * Bindings, in the order rate_dsd_vulkan.c writes them:
 *   0 coefficients   -- in: the response, one pair per tap.
 *   1 packed         -- in: DSD words, channel major, 32 frames per word.
 *   2 output_samples -- out: interleaved output frames, pairs.
 *
 * Push constants (parameters_t, 56 bytes): output_frames, decimation, taps,
 * channels, words_per_channel, frame_offset, lead_frames, valid_frames,
 * normalize, reserved, and the domain factor as the pair scale_high,
 * scale_low.
 *
 * Dispatch is two-dimensional, x over the output frames in workgroups of 128
 * and y one invocation per channel, hence both bounds tests.
 */

#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

#include "double_double.glsl"

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer Coefficients {
  dvec2 values[];
} coefficients;

layout(std430, binding = 1) readonly buffer PackedWords {
  uint packed_words[];
};

layout(std430, binding = 2) writeonly buffer OutputSamples {
  dvec2 values[];
} output_samples;

layout(push_constant) uniform Parameters {
  uint output_frames;
  uint decimation;
  uint taps;
  uint channels;
  uint words_per_channel;
  uint frame_offset;
  uint lead_frames;
  uint valid_frames;
  uint normalize;
  uint reserved;
  double scale_high;
  double scale_low;
} parameters;

const double SOX_SAMPLE_SCALE = 1.0 / 2147483647.0;


/* Accumulation for this stage, cheaper than the general pair addition.
 *
 * add_dd() renormalises both words against both (four two_sums, about 28
 * FP64 operations) because in general neither operand dominates.  Here the
 * accumulator, a partial sum of thousands of taps, always dominates the
 * single coefficient, so Dekker's form suffices at half the operations.  The
 * loop is bound by FP64 issue: on an RTX 3080, where FP64 issues at 1/64 of
 * FP32, it runs at about 88% of the FP64 issue rate, and the halving gives
 * 1.68x, which takes DSD64 past real time.
 *
 * Accuracy is unchanged.  Where the exact sum fits in a pair the accumulation
 * reaches it: a response spanning s binary orders of magnitude, of n 53-bit
 * coefficients, needs s + 53 + log2 n bits against the pair's 106.  Every
 * default-quality plan (DSD64 to DSD512, to 44.1, 88.2 and 192 kHz) fits, and
 * the captured pairs match the exact rational sum in every bit.  `rate -v` on
 * DSD64 designs 66157 taps over 66 orders, which needs 136 bits and cannot be
 * exact; both forms then read 640.6699955104903 dB against the exact sum.
 *
 * The DSD family in sox-benchmark checks this by scoring the pairs this stage
 * writes to its diagnostic capture; run it before widening the response or
 * the quality range. */
dvec2 accumulate_dd(dvec2 total, dvec2 term)
{
  const dvec2 high = two_sum(total.x, term.x);
  precise double low = (high.y + total.y) + term.y;

  return normalize_dd(high.x, low);
}

void main()
{
  const uint output_frame = gl_GlobalInvocationID.x;
  const uint channel = gl_GlobalInvocationID.y;

  if (output_frame >= parameters.output_frames || channel >= parameters.channels)
    return;

  const uint start = parameters.frame_offset + output_frame * parameters.decimation;
  const uint base = channel * parameters.words_per_channel;
  dvec2 sum = dvec2(0.0);
  /* The taps that land on a frame the stream has.  Outside that range, at
   * the head (the response's delay) and the tail (what it holds after the
   * input ends), the frame is a zero sample; both are ranges, so a clamp
   * replaces a test per tap. */
  const uint last = parameters.valid_frames > start ?
      min(parameters.valid_frames - start, parameters.taps) : 0u;
  uint tap = parameters.lead_frames > start ?
      min(parameters.lead_frames - start, parameters.taps) : 0u;
  uint frame = start + tap;

  /* One word load per thirty-two taps.  A DSD frame is one bit, so the
   * multiply reduces to adding the coefficient pair or its negation. */
  while (tap < last) {
    const uint word = packed_words[base + (frame >> 5u)];
    const uint bit = frame & 31u;
    const uint run = min(32u - bit, last - tap);
    uint index;

    for (index = 0u; index < run; ++index) {
      const dvec2 coefficient = coefficients.values[tap + index];

      sum = accumulate_dd(
          sum,
          ((word >> (bit + index)) & 1u) != 0u ? coefficient : -coefficient);
    }
    tap += run;
    frame += run;
  }
  if (parameters.normalize != 0u)
    sum = multiply_dd_scalar(sum, SOX_SAMPLE_SCALE);
  /* The domain factor, applied to the pair before collapsing: one rounding
   * instead of two, which keeps this profile's accuracy on a scaled-sample
   * build. */
  sum = multiply_dd(sum, dvec2(parameters.scale_high, parameters.scale_low));
  output_samples.values[output_frame * parameters.channels + channel] = sum;
}
