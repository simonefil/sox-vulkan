#version 450

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer InputSamples {
  vec2 values[];
} input_samples;

layout(std430, binding = 1) writeonly buffer StreamSamples {
  vec2 values[];
} stream_samples;

layout(std430, binding = 2) buffer ClipCounter {
  uint clipped_samples[];
} clips;

layout(push_constant) uniform Parameters {
  uint input_base_element;
  uint output_first_frame;
  uint frames;
  uint input_frame_stride;
  uint input_channel_stride;
  uint channels;
  uint quantize_sox_sample;
  uint clip_index;
} parameters;

void main()
{
  const uint frame = gl_GlobalInvocationID.x;
  const uint channel = gl_GlobalInvocationID.y;

  if (frame >= parameters.frames || channel >= parameters.channels)
    return;

  const uint input_index =
      parameters.input_base_element +
      frame * parameters.input_frame_stride +
      channel * parameters.input_channel_stride;
  const uint output_index = (parameters.output_first_frame + frame) * parameters.channels + channel;
  vec2 value = input_samples.values[input_index];

  if (parameters.quantize_sox_sample != 0u) {
    float rounded = roundEven(value.x + value.y);

    if (rounded < -2147483648.0 || rounded > 2147483647.0)
      atomicAdd(clips.clipped_samples[parameters.clip_index], 1u);
    rounded = clamp(rounded, -2147483648.0, 2147483647.0);
    value = vec2(rounded, 0.0);
  }
  stream_samples.values[output_index] = value;
}
