/* The FP32 member of the select family; rate_select_f64.comp carries the
 * family's rationale.  One float per sample and a plain multiply for the
 * normalisation.
 *
 * The fast profile lands here.  The family has no compensated
 * member because it does not accumulate -- see resident_kernel() in
 * rate_vulkan.c.
 *
 * Bindings, in the order run_resident_selection() in rate_vulkan.c writes
 * them:
 *   0 input_samples   -- in: the filtered block, planar.
 *   1 output_samples  -- out: the decimated block, interleaved.
 *
 * Push constants (select_parameters_t, 24 bytes): output_frames,
 * first_input_frame, input_step, input_channel_stride, channels and normalize.
 * first_input_frame and input_step together carry the
 * decimation phase across block boundaries.
 *
 * Dispatch is two-dimensional, x over output_frames in workgroups of 128 and
 * y one invocation per channel, hence both bounds tests.
 */

#version 450

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer InputSamples {
  float input_samples[];
};

layout(std430, binding = 1) writeonly buffer OutputSamples {
  float output_samples[];
};

layout(push_constant) uniform Parameters {
  uint output_frames;
  uint first_input_frame;
  uint input_step;
  uint input_channel_stride;
  uint channels;
  uint normalize;
} parameters;

const float SOX_SAMPLE_SCALE = 1.0 / 2147483647.0;

void main()
{
  uint output_frame = gl_GlobalInvocationID.x;
  uint channel = gl_GlobalInvocationID.y;
  if (output_frame >= parameters.output_frames || channel >= parameters.channels)
    return;

  uint input_frame = parameters.first_input_frame + output_frame * parameters.input_step;
  float scale = parameters.normalize != 0u ? SOX_SAMPLE_SCALE : 1.0;
  output_samples[
      output_frame * parameters.channels + channel] =
      input_samples[
          channel * parameters.input_channel_stride + input_frame] *
      scale;
}
