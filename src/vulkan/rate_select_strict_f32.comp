#version 450

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer InputSamples {
  vec2 values[];
} input_samples;

layout(std430, binding = 1) writeonly buffer OutputSamples {
  vec2 values[];
} output_samples;

layout(push_constant) uniform Parameters {
  uint output_frames;
  uint first_input_frame;
  uint input_step;
  uint input_channel_stride;
  uint channels;
  uint normalize;
  uint padding1;
  uint padding2;
} parameters;

const float SOX_SAMPLE_SCALE = 1.0 / 2147483647.0;

vec2 multiply_double_single(vec2 value, float scale)
{
  precise float product = value.x * scale;
  precise float residual = fma(value.x, scale, -product) + value.y * scale;
  precise float high = product + residual;
  precise float low = residual - (high - product);

  return vec2(high, low);
}

void main()
{
  const uint output_frame = gl_GlobalInvocationID.x;
  const uint channel = gl_GlobalInvocationID.y;

  if (output_frame >= parameters.output_frames || channel >= parameters.channels)
    return;

  const uint input_frame = parameters.first_input_frame + output_frame * parameters.input_step;
  vec2 value = input_samples.values[channel * parameters.input_channel_stride + input_frame];

  if (parameters.normalize != 0u)
    value = multiply_double_single(value, SOX_SAMPLE_SCALE);
  output_samples.values[output_frame * parameters.channels + channel] = value;
}
